{
  "fixture_version": 1,
  "type": "OrderState",
  "description": "Order-state machine vectors (ADR 0019 decision 8). Steps are literal: submit/cancel are submitter ops, venue steps are scripted venue events. cancel on an unknown, Initialized, terminal or already-pending order emits nothing. A step with expect_error must be an IllegalTransition of that kind (transition|overfill|fill_mismatch|invalid_quantity): state unchanged, no event. expect_events lists, per scenario, the wire-event projection each op yields (at most one; duplicate no-ops yield none); only the keys listed are compared. quantity on order_rejected/cancelled/expired is the released remainder. Under profile l1 (requires_ack false) order_accepted is removed from both sides before comparing; gateways run only scenarios whose profile list includes theirs, and price-driven (bar) sims only those with bar_realisable true; the rest are not_applicable for them, by name.",
  "profiles": {
    "l1": {
      "requires_ack": false,
      "emits_expiry": false
    },
    "ack": {
      "requires_ack": true,
      "emits_expiry": true
    }
  },
  "scenarios": [
    {
      "name": "partial_fill_sequence",
      "description": "A partial fill, then a cancel the venue honours: the remainder is released.",
      "profile": [
        "l1",
        "ack"
      ],
      "bar_realisable": false,
      "steps": [
        {
          "op": "submit",
          "order_id": "S-1",
          "side": "buy",
          "symbol": "X",
          "quantity": 3.0,
          "order_type": "limit",
          "price": 10.0,
          "tif": "day",
          "ts": 1
        },
        {
          "op": "venue",
          "event": "fill",
          "order_id": "S-1",
          "last_qty": 1.0,
          "last_px": 10.0,
          "ts": 2
        },
        {
          "op": "cancel",
          "order_id": "S-1",
          "ts": 3
        },
        {
          "op": "venue",
          "event": "cancelled",
          "order_id": "S-1",
          "ts": 3
        }
      ],
      "expect_events": [
        {
          "type": "order",
          "order_id": "S-1",
          "status": "submitted"
        },
        {
          "type": "order_partially_filled",
          "order_id": "S-1",
          "last_qty": 1.0,
          "cum_qty": 1.0
        },
        {
          "type": "order_cancel_requested",
          "order_id": "S-1"
        },
        {
          "type": "order_cancelled",
          "order_id": "S-1",
          "quantity": 2.0
        }
      ],
      "expect_state": {
        "S-1": {
          "status": "cancelled",
          "filled_qty": 1.0,
          "cancel_requested": false
        }
      }
    },
